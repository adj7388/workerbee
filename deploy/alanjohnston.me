    server {
        server_name alanjohnston.me www.alanjohnston.me;

        if ($host !~* alanjohnston.me$) {
            return 444;
        }

        location / {
            # Proxy pass to Gunicorn, http via unix socket.
            # See `workerbee.service` for the other end of the connection
            # Yes, this URI is weird.
            # Yes, the colon at the end is necessary (or maybe not? don't ask).
            # Yes, it works — DO NOT TOUCH — unless you want to change and proxy with vanilla http
            proxy_pass http://unix:/run/workerbee/workerbee.sock:;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        listen 443 ssl; # managed by Certbot
        ssl_certificate /etc/letsencrypt/live/alanjohnston.me/fullchain.pem; # managed by Certbot
        ssl_certificate_key /etc/letsencrypt/live/alanjohnston.me/privkey.pem; # managed by Certbot
        include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
        ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
    }

    server {

        listen 80;
        server_name alanjohnston.me www.alanjohnston.me;

        if ($host = www.alanjohnston.me) {
            return 301 https://$host$request_uri;
        } # managed by Certbot

        if ($host = alanjohnston.me) {
            return 301 https://$host$request_uri;
        } # managed by Certbot

        return 444; # managed by Certbot

    }
