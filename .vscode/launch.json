{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Workerbee",
            "type": "debugpy",
            "request": "launch",
            "module": "workerbee",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "-s",
                "-r", "c",
                "-a", "evitpa",
                "--groupby", "length",
                "--json",
                "-w", "SCOWL-default-60"
            ]
        },
        {
            "name": "Python: Flask",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "wsgi:app",
                "SECRET_KEY": "dev",
                "FLASK_CONFIG": "DevConfig"
            },
            "args": [
                "run",
                "--debug"
            ],
            "jinja": true,
            "justMyCode": true
        }
    ]
}